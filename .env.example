# Copy to .env and fill in from Back4app → your app → App Settings → Security & Keys.
# The browser only ever receives APP_ID, JS_KEY and SERVER_URL (served by /config.js).
# MASTER_KEY is used only by the scripts in scripts/ — never by server.js, never committed.

APP_ID=
JS_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com

# Shown as a banner in the UI when true. Set it on the Containers app for the public demo only.
DEMO=false

# Port the Express server listens on (Containers sets PORT itself).
PORT=8080
